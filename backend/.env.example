# Copy to .env and fill in. All values shown are dev defaults.

# Database MUST be UTF8-encoded (₹ appears in stored text; WIN1252 rejects it).
DATABASE_URL=postgresql://saahvik:saahvik@localhost:5432/saahvik?schema=public

PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# CORS — comma-separated explicit origin list. Never "*".
CORS_ORIGINS=https://app.saahvik.com,http://localhost:5173,http://localhost:4200

# File uploads (photos, ID docs, complaint attachments).
# Served ONLY through the authenticated GET /api/v1/files/* endpoint.
UPLOADS_PATH=./uploads

# 2FA
TOTP_ISSUER=Saahvik

# Password-reset emails (AWS SES). When unset, reset links are logged to stdout.
AWS_SES_FROM_EMAIL=contact@saahvik.com
AWS_SES_REGION=ap-south-1
APP_URL=https://app.saahvik.com
