{
  "name": "saahvik-api",
  "version": "0.2.0",
  "private": true,
  "description": "Saahvik hostel management API — Basic plan backend",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "test:invoice-concurrency": "tsx test/invoice-concurrency.ts",
    "test:advance-concurrency": "tsx test/advance-concurrency.ts",
    "test:refund-reversal": "tsx test/refund-reversal.ts",
    "test:dues-sort": "tsx test/dues-sort.ts",
    "test:dues-accrual": "tsx test/dues-accrual.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1101.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "otplib": "^12.0.1",
    "pdfkit": "^0.15.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@expo-google-fonts/noto-sans": "^0.2.3",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.13.8",
    "@types/qrcode": "^1.5.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^6.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
