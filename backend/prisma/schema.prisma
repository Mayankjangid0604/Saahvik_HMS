// Saahvik — Basic plan schema.
// Money is ALWAYS integer paisa. Enum values are lowercase to match the
// frontend API contract in frontend/src/api/types.ts verbatim (the wire
// format and the DB share one vocabulary — no mapping layer).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- enums ----------

enum Plan {
  basic
}

enum BillingCycle {
  monthly
  yearly
}

enum RoomType {
  single
  double
  triple
  quad
  dorm
}

enum FeeMode {
  fixed
  variable
}

enum BedStatus {
  occupied
  vacant
  maintenance
}

enum ResidentStatus {
  active
  notice
  alumni
}

enum IdDocumentType {
  aadhaar
  pan
  passport
  driving_license
  voter_id
}

enum Occupation {
  student
  working
}

enum PaymentMethod {
  cash
  upi
  bank_transfer
  card
  cheque
}

enum PaymentType {
  rent
  deposit
  fine
  other
}

enum PaymentStatus {
  completed
  refunded
  partially_refunded
}

enum FeeCycle {
  monthly
  quarterly
  half_yearly
  yearly
  one_time
}

enum InvoiceStatus {
  unpaid
  partially_paid
  paid
  cancelled
}

enum DepositStatus {
  held
  partially_refunded
  refunded
  forfeited
}

enum DiscountKind {
  flat
  percent
}

enum ComplaintStatus {
  open
  in_progress
  resolved
  closed
}

enum ComplaintPriority {
  low
  medium
  high
}

enum ComplaintCategory {
  electrical
  plumbing
  cleaning
  food
  wifi
  furniture
  security
  other
}

enum StaffRole {
  manager
  receptionist
  maintenance
}

enum StaffStatus {
  active
  inactive
}

enum NotificationKind {
  payment
  complaint
  due
  system
}

enum AdmissionFieldType {
  text
  number
  date
  phone
  select
  textarea
  file
  auto
}

// ---------- Beginner phase (BG-1) enums ----------

// Category for a categorized resident document upload (feature 12).
enum DocumentCategory {
  id_proof
  admission_form
  medical_certificate
  agreement
  photo
  other
}

// A pre-booking hold on a bed/room before an actual check-in (feature 5). A
// reservation NEVER sets Bed.status = occupied — it is a distinct state that
// only becomes an occupied bed when converted into a real Resident.
enum ReservationStatus {
  held // active hold, blocks the bed from being double-booked
  confirmed // deposit taken / firmed up, still not checked in
  converted // turned into an actual Resident (bed now occupied)
  cancelled
  expired // holdUntil passed without conversion
}

// Vendor + purchase categories (feature 9).
enum VendorCategory {
  groceries
  maintenance
  utilities
  furniture
  services
  supplies
  other
}

// Entity a saved search / global search targets (features 10, 11).
enum SearchEntity {
  residents
  rooms
  staff
  complaints
  global
}

// Report scheduling (feature 16).
enum ScheduledReportType {
  occupancy
  dues
  residents
  monthly_collection
  staff
}

enum ReportFormat {
  pdf
  xlsx
}

enum ScheduleFrequency {
  daily
  weekly
  monthly
}

// Basic approval workflow (feature 18) — intentionally simple, owner sign-off.
enum ApprovalType {
  expense
  purchase
  discount
  refund
  room_block
  other
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

// ---------- core tenancy ----------

model Organization {
  id                     String       @id @default(uuid())
  name                   String
  hostelName             String?
  addressLine            String?
  city                   String?
  state                  String?
  pincode                String?
  phone                  String?
  email                  String?
  gstin                  String?
  // GST-compliant invoicing config (feature 8). gstEnabled toggles the GST
  // breakdown on invoices/PDFs; gstRatePercent is a whole-number percent
  // (0/5/12/18/28 — GST slabs are integers). gstInclusive = stored line-item
  // amounts already include tax (tax is extracted) vs. exclusive (tax added on
  // top). Additive: existing invoice generation is unaffected when gstEnabled
  // is false (the default).
  gstEnabled             Boolean      @default(false)
  gstRatePercent         Int          @default(0)
  gstInclusive           Boolean      @default(false)
  // Branding (feature 17): logoKey is a /files storage key (served only through
  // the authenticated file endpoint, like every other upload). Theme colors are
  // hex strings used to reskin invoice/receipt PDFs first, UI chrome later.
  logoKey                String?
  themeColorPrimary      String?
  themeColorAccent       String?
  plan                   Plan         @default(basic)
  planBillingCycle       BillingCycle @default(monthly)
  planStartDate          DateTime?
  trialEndsAt            DateTime?
  onboardingCompleted    Boolean      @default(false)
  // Resident-cap soft blocks: set when the org first exceeds a cap; a
  // check-in is refused once the matching grace window is > 5 days old.
  graceActiveStartedAt   DateTime?
  graceLifetimeStartedAt DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  owners            Owner[]
  staff             Staff[]
  hostels           Hostel[]
  wings             Wing[]
  rooms             Room[]
  beds              Bed[]
  residents         Resident[]
  payments          Payment[]
  complaints        Complaint[]
  notifications     Notification[]
  invoices          Invoice[]
  deposits          Deposit[]
  discounts         Discount[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  reservations      Reservation[]
  vendors           Vendor[]
  purchaseRecords   PurchaseRecord[]
  residentDocuments ResidentDocument[]
}

model Owner {
  id                     String    @id @default(uuid())
  orgId                  String
  name                   String
  email                  String    @unique
  phone                  String?
  passwordHash           String
  twoFactorSecret        String?
  // Secret generated by GET /auth/2fa/setup, promoted to twoFactorSecret
  // only after POST /auth/2fa/verify-setup succeeds.
  twoFactorPendingSecret String?
  twoFactorEnabled       Boolean   @default(false)
  twoFactorBackupCodes   String[] // bcrypt hashes; a code is removed once used
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?
  tokenVersion           Int       @default(0) // bumped on password change; old JWTs die
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  org        Organization    @relation(fields: [orgId], references: [id])
  challenges AuthChallenge[]
}

// Short-lived 2FA login challenge (the tempSessionId handed out by
// POST /auth/login when the owner has 2FA enabled).
model AuthChallenge {
  id        String   @id @default(uuid())
  ownerId   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model Staff {
  id           String      @id @default(uuid())
  orgId        String
  name         String
  email        String
  phone        String?
  passwordHash String
  role         StaffRole
  status       StaffStatus @default(active)
  // Fine-grained capabilities on top of the role. Values come from
  // STAFF_PERMISSIONS (src/staff/permissions.ts) — currently "manageExpenses".
  permissions  String[]    @default([])
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  org Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, email])
}

model Hostel {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org   Organization @relation(fields: [orgId], references: [id])
  wings Wing[]
  rooms Room[]
}

// Optional layer between a hostel and its rooms (e.g. "A Block", "Girls Wing").
// A room may belong to no wing (null) — wings are opt-in per org.
model Wing {
  id        String   @id @default(uuid())
  orgId     String
  hostelId  String
  name      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Organization @relation(fields: [orgId], references: [id])
  hostel Hostel       @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  rooms  Room[]

  @@unique([hostelId, name])
  @@index([orgId])
}

// ---------- rooms & beds ----------

model Room {
  id                  String   @id @default(uuid())
  orgId               String
  hostelId            String
  wingId              String?
  number              String
  floor               Int
  type                RoomType
  capacity            Int
  feeMode             FeeMode  @default(variable)
  fixedFeeAmountPaisa Int?
  monthlyRentPaisa    Int      @default(0)
  // Room amenity tags (feature 2), e.g. ["ac", "attached_bathroom", "balcony"].
  // Free-form strings; a hardcoded starter set (ROOM_AMENITIES) validates input
  // in v1, extensible to an org-configurable list later.
  amenities           String[] @default([])
  // Maintenance / temporary block (feature 3). A blocked room is distinct from
  // occupancy and cannot receive new residents (enforced in assignment logic).
  blocked             Boolean  @default(false)
  blockedReason       String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  org          Organization  @relation(fields: [orgId], references: [id])
  hostel       Hostel        @relation(fields: [hostelId], references: [id])
  wing         Wing?         @relation(fields: [wingId], references: [id])
  beds         Bed[]
  residents    Resident[]
  reservations Reservation[]

  @@unique([orgId, number])
}

model Bed {
  id         String    @id @default(uuid())
  orgId      String
  roomId     String
  label      String // A, B, C…
  status     BedStatus @default(vacant)
  residentId String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  org          Organization  @relation(fields: [orgId], references: [id])
  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  resident     Resident?     @relation(fields: [residentId], references: [id])
  reservations Reservation[]

  @@unique([roomId, label])
}

// ---------- residents ----------

model Resident {
  id                    String         @id @default(uuid())
  orgId                 String
  name                  String
  phone                 String
  email                 String?
  photoKey              String? // storage key — served only via authenticated /files/:key
  idDocKey              String?
  // Expiry of the primary ID document (feature 4). Nullable — many IDs (e.g.
  // Aadhaar) never expire. Surfaced by the expiring-documents report/flag.
  idDocExpiryDate       DateTime?
  status                ResidentStatus @default(active)
  roomId                String?
  joinDate              DateTime
  exitDate              DateTime?
  guardianName          String         @default("")
  guardianPhone         String         @default("")
  permanentAddress      String         @default("")
  idType                IdDocumentType @default(aadhaar)
  idNumber              String         @default("")
  occupation            Occupation     @default(student)
  institutionOrCompany  String?
  monthlyFeePaisa       Int            @default(0)
  depositPaisa          Int            @default(0)
  duesPaisa             Int            @default(0)
  // Prepaid rent balance: rent overpayments land here and net against dues on
  // read (see common/dues.ts effectiveDues). Distinct from depositPaisa/Deposit
  // (refundable security deposit) — this is credit toward future rent.
  advanceBalancePaisa   Int            @default(0)
  // "YYYY-MM" (Asia/Kolkata) of the last month this resident's rent was
  // accrued into duesPaisa by the monthly cron (finance/dues-accrual.service.ts).
  // Null until the first accrual run. Guards against double-accrual on
  // cron restart/overlap.
  lastDuesAccrualPeriod String?
  notes                 String?
  // Medical / dietary info (feature 7). Sensitive PII — served through the same
  // resident endpoints/authorization as the rest of the resident record; no new
  // exposure surface. All nullable; kept inline on Resident because the data is
  // 1:1 with the resident, not naturally a separate table.
  bloodGroup            String?
  allergies             String?
  dietaryPreference     String?
  medicalNotes          String?
  emergencyContactName  String?
  emergencyContactPhone String?
  // Answers to the org's configurable admission form, keyed by field key.
  // Validated at write time against AdmissionFieldDefinition rows.
  admissionData         Json?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  org        Organization       @relation(fields: [orgId], references: [id])
  room       Room?              @relation(fields: [roomId], references: [id])
  bed        Bed?
  payments   Payment[]
  complaints Complaint[]
  invoices   Invoice[]
  deposits   Deposit[]
  documents  ResidentDocument[]

  @@unique([orgId, phone])
  @@index([orgId, status])
  @@index([orgId, name])
}

model AdmissionFieldDefinition {
  id         String             @id @default(uuid())
  orgId      String
  key        String
  label      String
  fieldType  AdmissionFieldType
  options    Json? // string[] — only for "select"
  required   Boolean
  isDefault  Boolean            @default(false)
  validation String? // "aadhaar" | "pincode"
  autoFill   String? // "today" | "formNo"
  sortOrder  Int
  createdAt  DateTime           @default(now())

  @@unique([orgId, key])
  @@index([orgId, sortOrder])
}

// ---------- finance ----------

model Payment {
  id                  String        @id @default(uuid())
  orgId               String
  receiptNo           String // RCP-YYYY-#### sequential per org per year
  residentId          String
  amountPaisa         Int
  method              PaymentMethod
  type                PaymentType
  status              PaymentStatus @default(completed)
  paidAt              DateTime
  periodMonth         String? // "2026-07" for rent
  refundedPaisa       Int           @default(0)
  // How much of this (rent) payment exceeded dues and became advance balance,
  // captured at write time so dashboard "advance collected" is an exact fact.
  advanceAppliedPaisa Int           @default(0)
  notes               String?
  recordedByName      String

  org      Organization @relation(fields: [orgId], references: [id])
  resident Resident     @relation(fields: [residentId], references: [id])

  @@unique([orgId, receiptNo])
  @@index([orgId, paidAt])
}

model FeeStructure {
  id          String   @id @default(uuid())
  orgId       String
  name        String
  amountPaisa Int
  cycle       FeeCycle
  description String?
  createdAt   DateTime @default(now())

  assignments FeeAssignment[]
}

model FeeAssignment {
  id             String   @id @default(uuid())
  orgId          String
  feeStructureId String
  residentId     String
  startDate      DateTime
  amountPaisa    Int
  createdAt      DateTime @default(now())

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@unique([feeStructureId, residentId])
  @@index([orgId])
}

model Invoice {
  id            String        @id @default(uuid())
  orgId         String
  residentId    String
  invoiceNumber String // INV-YYYY-#### sequential per org per year
  amountPaisa   Int // total of line items
  paidPaisa     Int           @default(0)
  status        InvoiceStatus @default(unpaid)
  lineItems     Json // [{ description, amountPaisa }]
  issuedAt      DateTime?
  dueAt         DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  org      Organization @relation(fields: [orgId], references: [id])
  resident Resident     @relation(fields: [residentId], references: [id])

  @@unique([orgId, invoiceNumber])
  @@index([orgId, issuedAt])
}

// Concurrent-safe sequential numbering (invoices, receipts, complaint
// tickets, form numbers). Incremented with SELECT ... FOR UPDATE inside the
// same transaction as the insert that consumes the number.
model SequenceCounter {
  id      String @id @default(uuid())
  orgId   String
  scope   String // "invoice" | "receipt" | "complaint" | "form"
  year    Int // 0 for scopes that do not reset yearly
  lastSeq Int    @default(0)

  @@unique([orgId, scope, year])
}

model Deposit {
  id            String        @id @default(uuid())
  orgId         String
  residentId    String
  amountPaisa   Int
  refundedPaisa Int           @default(0)
  status        DepositStatus @default(held)
  notes         String?
  history       Json          @default("[]") // append-only: [{ action, amountPaisa, actorId, ts }]
  collectedOn   DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  org      Organization @relation(fields: [orgId], references: [id])
  resident Resident     @relation(fields: [residentId], references: [id])

  @@index([orgId, status])
}

model Discount {
  id        String       @id @default(uuid())
  orgId     String
  name      String
  kind      DiscountKind
  value     Int // paisa when flat, percentage points when percent
  active    Boolean      @default(true)
  validTill DateTime?
  createdAt DateTime     @default(now())

  org          Organization          @relation(fields: [orgId], references: [id])
  applications DiscountApplication[]
}

model DiscountApplication {
  id              String   @id @default(uuid())
  orgId           String
  discountId      String
  residentId      String
  appliedByUserId String?
  createdAt       DateTime @default(now())

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@unique([discountId, residentId])
}

// ---------- expenses ----------

model ExpenseCategory {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id])
  expenses Expense[]

  @@unique([orgId, name])
  @@index([orgId, sortOrder])
}

model Expense {
  id             String        @id @default(uuid())
  orgId          String
  categoryId     String
  label          String
  amountPaisa    Int
  method         PaymentMethod
  spentAt        DateTime
  notes          String?
  attachmentKey  String? // storage key — served only via authenticated /files/:key
  recordedByName String
  createdAt      DateTime      @default(now())

  org      Organization    @relation(fields: [orgId], references: [id])
  category ExpenseCategory @relation(fields: [categoryId], references: [id])
  purchase PurchaseRecord?

  @@index([orgId, spentAt])
  @@index([orgId, categoryId])
}

// ---------- complaints ----------

model Complaint {
  id                String            @id @default(uuid())
  orgId             String
  hostelId          String
  ticketNo          String // CMP-####
  title             String
  description       String
  category          ComplaintCategory
  priority          ComplaintPriority @default(medium)
  status            ComplaintStatus   @default(open)
  residentId        String?
  assignedToStaffId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  org         Organization          @relation(fields: [orgId], references: [id])
  resident    Resident?             @relation(fields: [residentId], references: [id])
  timeline    ComplaintEvent[]
  attachments ComplaintAttachment[]

  @@unique([orgId, ticketNo])
  @@index([orgId, status])
}

model ComplaintEvent {
  id          String          @id @default(uuid())
  complaintId String
  status      ComplaintStatus
  note        String?
  byName      String
  at          DateTime        @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
}

model ComplaintAttachment {
  id          String  @id @default(uuid())
  complaintId String
  fileName    String
  fileType    String
  fileKey     String? // storage key — served only via authenticated /files/:key

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
}

// ---------- notifications ----------

model Notification {
  id        String           @id @default(uuid())
  orgId     String
  userId    String // owner or staff id
  userType  String // "owner" | "staff"
  kind      NotificationKind
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, userId, read])
}

model NotificationPreference {
  id                String  @id @default(uuid())
  orgId             String
  userId            String
  userType          String
  duesReminder      Boolean @default(true)
  paymentReceived   Boolean @default(true)
  newComplaint      Boolean @default(true)
  complaintResolved Boolean @default(true)
  weeklySummary     Boolean @default(true)
  channelInApp      Boolean @default(true)
  channelEmail      Boolean @default(false)

  @@unique([orgId, userId, userType])
}

// ---------- audit ----------

// READ ONLY from the API — no update or delete endpoints ever.
// Rows are written from within service methods only (AuditService).
model AuditLogEntry {
  id          String   @id @default(uuid())
  orgId       String
  actorUserId String
  actorName   String
  actorRole   String
  action      String // e.g. "recorded_payment", "added_resident"
  entityType  String
  entityId    String
  entityLabel String
  details     Json // structured diff or context
  createdAt   DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, action])
}

// ---------- Beginner phase (BG-1) models ----------

// Categorized resident document with optional expiry (features 4 & 12). The
// primary ID lives on Resident.idDocKey/idDocExpiryDate; this table holds any
// number of additional categorized documents (medical certificate, agreement…).
// fileKey is a /files storage key served only through the authenticated
// endpoint — never a raw path.
model ResidentDocument {
  id             String           @id @default(uuid())
  orgId          String
  residentId     String
  category       DocumentCategory @default(other)
  fileKey        String
  label          String?
  expiryDate     DateTime?
  uploadedByName String
  uploadedAt     DateTime         @default(now())

  org      Organization @relation(fields: [orgId], references: [id])
  resident Resident     @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([orgId, residentId])
  @@index([orgId, category])
  @@index([orgId, expiryDate])
}

// Pre-booking hold (feature 5). Distinct from the Bed/Resident 1:1 binding: a
// reservation records intent and (optionally) targets a specific bed, but does
// not occupy it. residentId is null until conversion produces a real Resident.
model Reservation {
  id              String            @id @default(uuid())
  orgId           String
  roomId          String
  bedId           String?
  residentName    String
  residentPhone   String
  // Set only after the reservation is converted into an actual Resident.
  residentId      String?
  status          ReservationStatus @default(held)
  expectedCheckIn DateTime
  // Auto-expiry cutoff for the hold; null = no auto-expiry.
  holdUntil       DateTime?
  monthlyFeePaisa Int               @default(0)
  depositPaisa    Int               @default(0)
  notes           String?
  createdByName   String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  org  Organization @relation(fields: [orgId], references: [id])
  room Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bed  Bed?         @relation(fields: [bedId], references: [id])

  @@index([orgId, status])
  @@index([orgId, roomId])
}

// Vendor directory (feature 9). Kept separate from Expense — a vendor is a
// standing counterparty, an expense is a booked outflow.
model Vendor {
  id            String         @id @default(uuid())
  orgId         String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  category      VendorCategory @default(other)
  active        Boolean        @default(true)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  org       Organization     @relation(fields: [orgId], references: [id])
  purchases PurchaseRecord[]

  @@unique([orgId, name])
  @@index([orgId, active])
}

// Purchase record (feature 9). Amount in integer paisa. Optional 1:1 link to a
// booked Expense (expenseId) so a purchase can flow into the finance ledger
// without merging the two concepts.
model PurchaseRecord {
  id             String         @id @default(uuid())
  orgId          String
  vendorId       String
  label          String
  amountPaisa    Int
  category       VendorCategory @default(other)
  purchasedAt    DateTime
  invoiceRef     String?
  expenseId      String?        @unique
  notes          String?
  attachmentKey  String? // storage key — served only via authenticated /files/:key
  recordedByName String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  org     Organization @relation(fields: [orgId], references: [id])
  vendor  Vendor       @relation(fields: [vendorId], references: [id])
  expense Expense?     @relation(fields: [expenseId], references: [id])

  @@index([orgId, purchasedAt])
  @@index([orgId, vendorId])
}

// Per-user saved search (feature 11). Scoped to the user (userId + userType),
// NOT shared across the org. Follows the light orgId-as-plain-field pattern
// (like NotificationPreference / AuditLogEntry) — no Organization back-relation.
model SavedSearch {
  id        String       @id @default(uuid())
  orgId     String
  userId    String
  userType  String // "owner" | "staff"
  name      String
  entity    SearchEntity @default(global)
  query     Json // { term?, filters? } — opaque to the backend, replayed by the client
  createdAt DateTime     @default(now())

  @@index([orgId, userId, userType])
}

// Report scheduling (feature 16). Stores schedule config only; the runner
// GENERATES AND STORES a ReportRun — it does NOT deliver (email/WhatsApp is
// Phase BG-5). nextRunAt is advanced by the scheduler after each run.
model ReportSchedule {
  id              String              @id @default(uuid())
  orgId           String
  createdByUserId String
  name            String
  reportType      ScheduledReportType
  format          ReportFormat        @default(pdf)
  frequency       ScheduleFrequency   @default(weekly)
  filters         Json?
  active          Boolean             @default(true)
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  runs ReportRun[]

  @@index([orgId, active])
  @@index([nextRunAt])
}

// A generated-and-stored report artifact (feature 16 "generate and store"
// stub for delivery). fileKey is a /files storage key.
model ReportRun {
  id         String              @id @default(uuid())
  orgId      String
  scheduleId String?
  reportType ScheduledReportType
  format     ReportFormat
  fileKey    String
  createdAt  DateTime            @default(now())

  schedule ReportSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
}

// Basic single-step approval (feature 18). A staff member raises a request; an
// owner approves or rejects. Intentionally NOT a generic workflow engine.
model ApprovalRequest {
  id                String         @id @default(uuid())
  orgId             String
  type              ApprovalType
  status            ApprovalStatus @default(pending)
  requestedByUserId String
  requestedByName   String
  entityType        String
  entityId          String?
  summary           String
  // Snapshot of the pending action's payload, applied verbatim on approval.
  payload           Json?
  decidedByUserId   String?
  decidedByName     String?
  decisionNote      String?
  decidedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([orgId, status])
  @@index([orgId, createdAt])
}
